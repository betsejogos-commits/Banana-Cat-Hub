if getgenv().__BF_LOADED then return getgenv().__BF_RESULT end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")
local NetworkClient = game:GetService("NetworkClient")
local GuiService = game:GetService("GuiService")

-- Função que simula perfeitamente a queda de internet (Error Code: 277) antes de sair
local function ExecutarInternetSpoof()
    pcall(function()
        settings().Network.IncomingReplicationLag = 999999
        NetworkClient:SetServerSimulationRadius(0)
        GuiService:SetErrorMessageChangedPrompt("Por favor, verifique sua conexão com a internet e tente novamente.\n(Error Code: 277)", 277, Enum.ConnectionError.DisconnectErrors)
        task.wait(0.1)
        LocalPlayer:Destroy() 
    end)
end

-- Interceptador Metatable para capturar métodos nativos de Kick e Ban antes de executarem
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and (string.find(string.lower(self.Name), "cheat") or string.find(string.lower(self.Name), "detect") or self.Name == "Admin" or self.Name == "Report") then
        return nil
    end
    return oldNamecall(self, ...)
end)

mt.__index = newcclosure(function(self, key)
    if self == LocalPlayer and (string.lower(key) == "kick" or string.lower(key) == "ban") then
        ExecutarInternetSpoof()
        return newcclosure(function() end)
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

game:GetService("CoreGui").ChildAdded:Connect(function(child)
    if string.find(string.lower(child.Name), "prompt") or string.find(string.lower(child.Name), "kick") or string.find(string.lower(child.Name), "ban") then
        ExecutarInternetSpoof()
    end
end)

