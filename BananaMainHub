-- Controlador do encadeamento sequencial da verificação
local carregamentoConcluido = false

task.spawn(function()
    local steps = {
        {0.50, "Loading UI..."},
        {1.00, "Loading Security..."}
    }
    
    local TS = game:GetService("TweenService")
    local currentPercent = 0
    
    for _, step in ipairs(steps) do
        statusLabel.Text = step[2]
        
        local tween = TS:Create(progressBarFill, TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(step[1], 0, 1, 0)
        })
        tween:Play()
        
        local targetPercent = step[1] * 100
        while currentPercent < targetPercent do
            currentPercent = currentPercent + math.random(2, 5) / 10
            if currentPercent > targetPercent then currentPercent = targetPercent end
            percentageLabel.Text = string.format("%.1f%%", currentPercent)
            task.wait(0.01)
        end
        
        tween.Completed:Wait()
        task.wait(0.05)
    end
    
    percentageLabel.Text = "100.0%"
    statusLabel.Text = "Finalizing..."
    task.wait(0.2)
    carregamentoConcluido = true
    loadingGui:Destroy()
end)

